# Example only: set actual values in your process or Connect content settings.
# R does not load this file automatically. .Renviron is ignored by Git.
OLSD_STORE=local
OLSD_BOARD_PATH=outputs/board
OLSD_PIN_PREFIX=olsd
OLSD_REQUEST_PAUSE=0.25
OLSD_OUTPUT_PATH=outputs/runs
OLSD_LOCK_PATH=outputs/collector.lock
OLSD_DISPLAY_TZ=America/New_York

# Connect deployments: set OLSD_STORE=connect and the same prefix in both items.
# The prefix includes the pin owner's Connect username, not a GitHub username.
# OLSD_PIN_PREFIX=connect-user/olsd
# CONNECT_SERVER=https://connect.example.org
# CONNECT_API_KEY=<configure-securely-in-connect>
# OLSD_APP_URL=https://connect.example.org/content/your-history-app
# OLSD_SOURCE_REVISION=<deployed-commit-sha>
